'use strict';
const $=s=>document.querySelector(s);const money=c=>new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format((c||0)/100);const labels={aguardando_whatsapp:'Aguardando WhatsApp',recebido:'Recebido',confirmado:'Confirmado',em_preparo:'Em preparo',pronto:'Pronto',saiu_para_entrega:'Saiu para entrega',entregue:'Entregue',cancelado:'Cancelado'};const flow=['aguardando_whatsapp','recebido','confirmado','em_preparo','pronto','saiu_para_entrega','entregue'];function esc(v){return String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}async function track(code,phone){const r=await fetch(`/api/orders/${encodeURIComponent(code)}?phone=${encodeURIComponent(phone)}`);const d=await r.json();if(!r.ok)throw new Error(d.error||'Pedido não encontrado.');return d.order}function render(o){const result=$('#trackingResult');result.classList.remove('hidden');if(o.status==='cancelado'){result.innerHTML=`<div class="error"><b>Pedido cancelado</b><p>Entre em contato com o estabelecimento para mais informações.</p></div>`;return}const idx=flow.indexOf(o.status);const timeline=flow.map((s,i)=>`<div class="step ${i<idx?'done':i===idx?'current':''}"><span>${labels[s]}</span></div>`).join('');const items=o.items.map(i=>`<div class="item"><span><b>${i.quantity}x</b> ${esc(i.name)}</span><strong>${money(i.total)}</strong></div>`).join('');result.innerHTML=`<div class="order-head"><div><p class="eyebrow">PEDIDO ${esc(o.code)}</p><h2>${labels[o.status]}</h2></div><strong>${money(o.total)}</strong></div><div class="order-meta"><span>${new Date(o.createdAt).toLocaleString('pt-BR')}</span><span>${o.store==='restaurant'?'Restaurante':'Lanches'}</span><span>${o.fulfillment==='delivery'?'Entrega':'Retirada'}</span></div><div class="timeline">${timeline}</div><div class="items">${items}</div>`}
$('#trackingForm').addEventListener('submit',async e=>{e.preventDefault();const fd=new FormData(e.currentTarget);const r=$('#trackingResult');r.classList.add('hidden');try{const o=await track(fd.get('code').trim(),fd.get('phone'));render(o)}catch(err){r.classList.remove('hidden');r.innerHTML=`<div class="error">${esc(err.message)}</div>`}});const params=new URLSearchParams(location.search);const saved=JSON.parse(localStorage.getItem('cf_last_order')||'null');const code=params.get('code')||saved?.code;const phone=params.get('phone')||saved?.phone;if(code&&phone){$('[name="code"]').value=code;$('[name="phone"]').value=phone;$('#trackingForm').requestSubmit()}
