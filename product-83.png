:root{
  --bg:#09090b;--surface:#111114;--surface-2:#17171b;--surface-3:#202026;--text:#f4f4f5;--muted:#a1a1aa;
  --line:rgba(255,255,255,.1);--orange:#ff6b00;--orange-2:#ff914d;--green:#22c55e;--red:#ef4444;--yellow:#f59e0b;
  --shadow:0 24px 80px rgba(0,0,0,.38);--radius:24px;--max:1240px
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.55;overflow-x:hidden}button,input,textarea,select{font:inherit}button,a{touch-action:manipulation}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}.hidden{display:none!important}.muted{color:var(--muted)}
.skip-link{position:fixed;left:16px;top:-80px;z-index:999;background:#fff;color:#000;padding:10px 16px;border-radius:10px}.skip-link:focus{top:16px}
.site-header{position:sticky;top:0;z-index:50;height:76px;padding:10px clamp(16px,4vw,52px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid transparent;transition:.3s;background:linear-gradient(180deg,rgba(9,9,11,.9),rgba(9,9,11,.35));backdrop-filter:blur(16px)}.site-header.scrolled{background:rgba(9,9,11,.92);border-color:var(--line);box-shadow:0 10px 40px rgba(0,0,0,.25)}
.brand{display:flex;align-items:center;gap:12px;min-width:0}.brand img{width:48px;height:48px;object-fit:cover;border-radius:14px;border:1px solid var(--line)}.brand span{display:flex;flex-direction:column}.brand b{font-size:.95rem;letter-spacing:.05em}.brand small{font-size:.72rem;color:var(--muted)}.header-actions{display:flex;align-items:center;gap:10px}.ghost-btn,.cart-button,.secondary-btn,.primary-btn,.icon-btn{border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:10px;transition:.2s}.ghost-btn{padding:11px 15px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.03);color:var(--text)}.ghost-btn:hover{border-color:rgba(255,107,0,.5);background:rgba(255,107,0,.08)}.cart-button{background:var(--orange);color:#111;padding:11px 16px;border-radius:999px;font-weight:800}.cart-button b{background:#111;color:#fff;border-radius:999px;min-width:24px;height:24px;display:grid;place-items:center;font-size:.75rem}
.primary-btn{min-height:48px;padding:13px 20px;background:linear-gradient(135deg,var(--orange),var(--orange-2));color:#121212;border-radius:14px;font-weight:850;box-shadow:0 12px 30px rgba(255,107,0,.2)}.primary-btn:hover{transform:translateY(-2px);box-shadow:0 16px 36px rgba(255,107,0,.28)}.primary-btn:disabled{opacity:.45;cursor:not-allowed;transform:none}.secondary-btn{min-height:48px;padding:13px 20px;background:transparent;color:var(--text);border:1px solid var(--line);border-radius:14px;font-weight:750}.secondary-btn:hover{border-color:rgba(255,107,0,.55);background:rgba(255,107,0,.06)}.full{width:100%}
.hero{position:relative;padding:clamp(48px,8vw,100px) clamp(16px,4vw,52px) 40px;overflow:hidden}.hero:before{content:"";position:absolute;inset:-20% -20% auto 40%;height:560px;background:radial-gradient(circle,rgba(255,107,0,.16),transparent 62%);filter:blur(12px);pointer-events:none}.hero-grid{max-width:var(--max);margin:auto;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(260px,.75fr);align-items:center;gap:44px}.eyebrow{margin:0 0 12px;color:var(--orange-2);font-size:.72rem;font-weight:900;letter-spacing:.2em}.hero h1{font-size:clamp(3.2rem,7.5vw,7.8rem);line-height:.88;letter-spacing:-.065em;margin:0;max-width:900px}.hero-lead{max-width:680px;color:#c7c7ce;font-size:clamp(1rem,1.5vw,1.22rem);margin:28px 0 22px}.trust-row{display:flex;flex-wrap:wrap;gap:10px}.trust-row span{padding:8px 12px;border-radius:999px;background:rgba(255,255,255,.04);border:1px solid var(--line);color:#d3d3d8;font-size:.82rem}.hero-mark{position:relative;min-height:360px;display:grid;place-items:center}.forge-symbol{width:min(330px,70vw);aspect-ratio:1;border-radius:34% 66% 58% 42%/40% 42% 58% 60%;display:grid;place-items:center;font-size:clamp(5rem,14vw,10rem);font-weight:1000;letter-spacing:-.12em;background:linear-gradient(145deg,#2c2c32,#0a0a0c 60%);box-shadow:inset 1px 1px 0 rgba(255,255,255,.12),0 30px 100px rgba(0,0,0,.5);color:transparent;-webkit-text-stroke:2px rgba(255,255,255,.7);transform:rotate(-6deg)}.pulse-ring{position:absolute;width:85%;aspect-ratio:1;border:1px solid rgba(255,107,0,.35);border-radius:50%;animation:pulse 3s ease-in-out infinite}@keyframes pulse{50%{transform:scale(1.08);opacity:.4}}
.store-choice{max-width:var(--max);margin:48px auto 0;padding:clamp(20px,3vw,32px);border:1px solid var(--line);background:linear-gradient(145deg,rgba(255,255,255,.06),rgba(255,255,255,.025));border-radius:32px;box-shadow:var(--shadow);backdrop-filter:blur(20px)}.choice-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:22px}.choice-head h2{margin:0;font-size:clamp(1.6rem,3vw,2.6rem);letter-spacing:-.04em}.choice-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.store-card{position:relative;text-align:left;border:1px solid var(--line);background:#101014;color:var(--text);border-radius:22px;padding:22px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:18px;cursor:pointer;transition:.25s;overflow:hidden}.store-card:after{content:"";position:absolute;inset:auto -20% -80% 30%;height:160px;background:radial-gradient(circle,rgba(255,107,0,.18),transparent 60%);opacity:0;transition:.3s}.store-card:hover,.store-card.active{border-color:rgba(255,107,0,.55);transform:translateY(-2px);background:linear-gradient(140deg,#19191e,#101014)}.store-card.active:after{opacity:1}.store-index{color:var(--orange);font-weight:950;font-size:.8rem}.store-content{display:flex;flex-direction:column}.store-content b{font-size:1.12rem}.store-content small{color:var(--muted)}.store-status{font-size:.74rem;font-weight:800;padding:7px 10px;border-radius:999px;background:rgba(34,197,94,.12);color:#86efac;border:1px solid rgba(34,197,94,.25)}.store-status.closed{background:rgba(239,68,68,.1);color:#fca5a5;border-color:rgba(239,68,68,.25)}
.catalog-section{max-width:var(--max);margin:auto;padding:70px clamp(16px,4vw,0) 90px}.catalog-head{display:flex;align-items:end;justify-content:space-between;gap:32px}.catalog-head h2{font-size:clamp(2.3rem,5vw,4.8rem);line-height:.95;letter-spacing:-.055em;margin:0 0 12px}.search-wrap{display:flex;flex-direction:column;gap:7px;min-width:min(360px,100%)}.search-wrap label,.form-grid label span,.checkout-shell>label span,.account-form label span,.field-block>span{font-size:.78rem;color:#d4d4d8;font-weight:750}.search-wrap input,input,textarea,select{width:100%;border:1px solid var(--line);background:#111115;color:var(--text);border-radius:14px;padding:13px 14px;outline:none;transition:.2s}.search-wrap input:focus,input:focus,textarea:focus,select:focus{border-color:var(--orange);box-shadow:0 0 0 3px rgba(255,107,0,.12)}textarea{resize:vertical}.category-tabs{display:flex;gap:10px;overflow:auto;padding:24px 0 18px;scrollbar-width:none}.category-tabs::-webkit-scrollbar{display:none}.category-tabs button{white-space:nowrap;border:1px solid var(--line);background:#111115;color:var(--muted);border-radius:999px;padding:10px 15px;cursor:pointer;font-weight:750}.category-tabs button.active{background:var(--text);color:#111;border-color:var(--text)}
.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.product-card{position:relative;min-height:290px;display:grid;grid-template-columns:42% 58%;border:1px solid var(--line);background:linear-gradient(145deg,#141418,#0e0e11);border-radius:26px;overflow:hidden;transition:.25s}.product-card:hover{transform:translateY(-4px);border-color:rgba(255,107,0,.38);box-shadow:0 24px 60px rgba(0,0,0,.3)}.product-card.unavailable{filter:saturate(.25);opacity:.68}.product-image{position:relative;min-height:100%}.product-image img{width:100%;height:100%;object-fit:cover}.product-card.unavailable .product-image:after{content:"INDISPONÍVEL";position:absolute;inset:0;display:grid;place-items:center;background:rgba(9,9,11,.68);color:#fff;font-weight:950;letter-spacing:.16em;font-size:.75rem}.product-body{padding:22px;display:flex;flex-direction:column}.product-topline{display:flex;justify-content:space-between;gap:12px}.category-label{font-size:.7rem;font-weight:900;color:var(--orange-2);letter-spacing:.12em;text-transform:uppercase}.stock-badge{font-size:.68rem;padding:5px 8px;border-radius:999px;background:rgba(255,255,255,.06);color:#d4d4d8}.stock-badge.low{color:#fdba74;background:rgba(245,158,11,.1)}.product-card h3{font-size:clamp(1.2rem,2vw,1.55rem);line-height:1.08;letter-spacing:-.035em;margin:14px 0 9px}.product-card p{color:var(--muted);font-size:.88rem;margin:0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.product-meta{font-size:.78rem;color:#d4d4d8;margin-top:10px}.product-bottom{margin-top:auto;padding-top:20px;display:flex;align-items:end;justify-content:space-between;gap:16px}.prices{display:flex;flex-direction:column}.prices del{font-size:.75rem;color:#71717a}.prices strong{font-size:1.24rem}.product-add{border:0;background:var(--orange);color:#111;border-radius:12px;padding:10px 13px;font-weight:900;cursor:pointer}.product-add:disabled{background:#2c2c32;color:#777;cursor:not-allowed}.badge-row{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}.badge-row span{font-size:.62rem;padding:4px 7px;border-radius:999px;background:rgba(255,255,255,.05);color:#d4d4d8}.empty-state{text-align:center;padding:60px;border:1px dashed var(--line);border-radius:24px;color:var(--muted);display:flex;flex-direction:column;gap:4px}
.system-section{padding:90px clamp(16px,4vw,52px);background:#f1f1f2;color:#111}.system-section>div{max-width:var(--max);margin-inline:auto}.system-section h2{font-size:clamp(2.5rem,5vw,5.5rem);line-height:.95;letter-spacing:-.06em;max-width:820px;margin:0 0 45px}.system-section .eyebrow{color:#c44f00}.system-flow{max-width:var(--max);margin:auto;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#ccc;border:1px solid #ccc;border-radius:24px;overflow:hidden}.system-flow article{background:#f8f8f8;padding:28px;min-height:230px}.system-flow span{font-weight:950;color:#f06400}.system-flow b{display:block;font-size:1.05rem;margin:45px 0 8px}.system-flow p{color:#626269;margin:0;font-size:.88rem}.system-links{display:flex;gap:12px;margin-top:28px}.system-section .secondary-btn{border-color:#c8c8cc;color:#111}.system-section .secondary-btn:hover{background:#e2e2e5}
.drawer{position:fixed;inset:0;z-index:100;visibility:hidden;pointer-events:none}.drawer.open{visibility:visible;pointer-events:auto}.drawer-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.66);opacity:0;transition:.25s}.drawer.open .drawer-backdrop{opacity:1}.drawer-panel{position:absolute;right:0;top:0;height:100%;width:min(480px,100%);background:#0f0f12;border-left:1px solid var(--line);transform:translateX(100%);transition:.3s cubic-bezier(.22,.8,.2,1);display:flex;flex-direction:column;box-shadow:var(--shadow)}.drawer.open .drawer-panel{transform:none}.drawer-panel header{padding:22px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.drawer-panel h2{margin:0}.icon-btn,.dialog-close{width:42px;height:42px;border:1px solid var(--line);background:#18181d;color:#fff;border-radius:12px;font-size:1.45rem}.cart-items{padding:18px;overflow:auto;flex:1}.cart-empty{padding:50px 18px;text-align:center;color:var(--muted)}.cart-item{border:1px solid var(--line);background:#141418;border-radius:18px;padding:14px;margin-bottom:12px}.cart-item-head{display:flex;justify-content:space-between;gap:15px}.cart-item h4{margin:0;font-size:.98rem}.cart-item small{color:var(--muted)}.cart-item-options{margin:8px 0;font-size:.78rem;color:#b7b7be}.cart-item-bottom{display:flex;align-items:center;justify-content:space-between}.mini-qty{display:flex;align-items:center;gap:8px}.mini-qty button{width:30px;height:30px;border:1px solid var(--line);background:#202026;color:#fff;border-radius:8px;cursor:pointer}.remove-btn{border:0;background:transparent;color:#fca5a5;cursor:pointer;font-size:.78rem}.cart-summary{padding:18px 22px calc(18px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:#111114}.cart-summary>div{display:flex;justify-content:space-between;font-size:1.1rem}.cart-summary small{display:block;color:var(--muted);margin:5px 0 14px}
dialog{padding:0;border:0;background:transparent;color:var(--text);max-width:none}dialog::backdrop{background:rgba(0,0,0,.74);backdrop-filter:blur(8px)}.product-dialog{width:min(980px,calc(100% - 24px));border-radius:26px;overflow:visible}.dialog-shell{display:grid;grid-template-columns:40% 60%;max-height:min(88vh,900px);background:#0e0e11;border:1px solid var(--line);border-radius:26px;overflow:hidden;box-shadow:var(--shadow);position:relative}.dialog-image-wrap{min-height:100%;background:#18181d}.dialog-image-wrap img{width:100%;height:100%;object-fit:cover}.dialog-content{padding:28px;overflow:auto}.dialog-close{position:absolute;z-index:2;right:16px;top:16px;cursor:pointer}.dialog-content h2{font-size:clamp(1.8rem,3vw,3rem);line-height:1;letter-spacing:-.05em;margin:0 50px 10px 0}.price-line{display:flex;align-items:center;gap:12px;margin:16px 0 22px}.price-line strong{font-size:1.6rem}.price-line del{color:#71717a}.option-group{padding:18px 0;border-top:1px solid var(--line)}.option-group-head{display:flex;justify-content:space-between;gap:10px;margin-bottom:10px}.option-group-head b{font-size:.95rem}.option-group-head small{color:var(--muted)}.option-list{display:grid;gap:8px}.option-item{display:flex;align-items:flex-start;gap:10px;padding:11px 12px;border:1px solid var(--line);background:#141418;border-radius:12px;cursor:pointer}.option-item:has(input:checked){border-color:rgba(255,107,0,.65);background:rgba(255,107,0,.08)}.option-item input{width:auto;margin-top:3px;accent-color:var(--orange)}.option-copy{display:flex;flex-direction:column;flex:1}.option-copy b{font-size:.86rem}.option-copy small{font-size:.72rem;color:var(--muted)}.option-price{font-size:.78rem;color:#fdba74;font-weight:800}.field-block{display:flex;flex-direction:column;gap:7px;padding-top:18px;border-top:1px solid var(--line)}.field-block>small{text-align:right;color:var(--muted)}.quantity-total{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:20px 0}.qty-control{display:flex;align-items:center;gap:12px;border:1px solid var(--line);padding:5px;border-radius:12px}.qty-control button{width:38px;height:38px;border:0;background:#202026;color:#fff;border-radius:9px;font-size:1.25rem;cursor:pointer}.quantity-total>div:last-child{text-align:right}.quantity-total small{display:block;color:var(--muted)}.quantity-total strong{font-size:1.25rem}
.checkout-dialog{width:min(650px,calc(100% - 24px))}.checkout-shell,.account-shell{position:relative;background:#101014;border:1px solid var(--line);border-radius:26px;padding:28px;box-shadow:var(--shadow);max-height:90vh;overflow:auto}.checkout-shell h2,.account-shell h2{font-size:2.2rem;letter-spacing:-.05em;margin:0}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.checkout-shell label,.form-grid label,.account-form label{display:flex;flex-direction:column;gap:7px;margin-top:14px}.choice-fieldset{margin:16px 0 0;border:1px solid var(--line);border-radius:14px;padding:12px}.choice-fieldset legend{padding:0 8px;color:#d4d4d8;font-size:.78rem}.choice-fieldset label{display:inline-flex;flex-direction:row;align-items:center;margin:0 22px 0 0}.choice-fieldset input{width:auto;accent-color:var(--orange)}.checkout-total{margin:20px 0;padding:16px;border:1px solid rgba(255,107,0,.3);background:rgba(255,107,0,.07);border-radius:16px;display:grid;grid-template-columns:1fr auto}.checkout-total strong{font-size:1.4rem}.checkout-total small{grid-column:1/-1;color:var(--muted)}.account-dialog{width:min(560px,calc(100% - 24px))}.account-tabs{display:grid;grid-template-columns:1fr 1fr;margin:20px 0 4px;border:1px solid var(--line);border-radius:12px;padding:4px}.account-tabs button{border:0;background:transparent;color:var(--muted);padding:10px;border-radius:9px;cursor:pointer}.account-tabs button.active{background:#fff;color:#111;font-weight:800}.account-form{display:grid;gap:2px}.my-orders{display:grid;gap:10px;margin:20px 0}.my-order{border:1px solid var(--line);border-radius:14px;padding:13px}.my-order div{display:flex;justify-content:space-between;gap:10px}.my-order small{color:var(--muted)}
.toast-region{position:fixed;right:18px;top:90px;z-index:300;display:grid;gap:10px}.toast{width:min(370px,calc(100vw - 36px));padding:14px 16px;border:1px solid var(--line);border-left:4px solid var(--orange);background:#17171b;border-radius:14px;box-shadow:var(--shadow);animation:toastin .25s ease}.toast.error{border-left-color:var(--red)}.toast.success{border-left-color:var(--green)}@keyframes toastin{from{opacity:0;transform:translateY(-10px)}}
.site-footer{max-width:var(--max);margin:auto;padding:46px clamp(16px,4vw,0);display:flex;justify-content:space-between;gap:30px;border-top:1px solid var(--line);color:var(--muted)}.site-footer>div:first-child{display:flex;gap:16px;max-width:600px}.site-footer img{width:58px;height:58px;object-fit:cover;border-radius:14px}.site-footer p{margin:0}.site-footer>div:last-child{display:flex;flex-direction:column;align-items:flex-end;gap:8px}.site-footer a:hover{color:var(--orange-2)}
@media(max-width:980px){.hero-grid{grid-template-columns:1fr}.hero-mark{display:none}.choice-grid{grid-template-columns:1fr}.product-grid{grid-template-columns:1fr}.system-flow{grid-template-columns:1fr 1fr}.desktop-only{display:none}.catalog-section{padding-inline:16px}}
@media(max-width:700px){.site-header{height:66px;padding:8px 12px}.brand img{width:42px;height:42px}.brand small{display:none}.ghost-btn{display:none}.cart-button span{display:none}.hero{padding-top:44px}.hero h1{font-size:clamp(3.2rem,16vw,5.3rem)}.trust-row{display:grid}.store-choice{border-radius:24px;padding:16px}.choice-head{display:block}.store-card{grid-template-columns:auto 1fr;padding:17px}.store-status{grid-column:2}.catalog-head{display:grid}.search-wrap{min-width:0}.product-card{grid-template-columns:1fr;min-height:auto}.product-image{height:220px}.product-body{min-height:270px}.system-flow{grid-template-columns:1fr}.system-links{display:grid}.dialog-shell{grid-template-columns:1fr;max-height:92vh}.dialog-image-wrap{height:230px}.dialog-content{padding:20px}.form-grid{grid-template-columns:1fr}.checkout-shell,.account-shell{padding:22px 16px}.site-footer{display:grid}.site-footer>div:last-child{align-items:flex-start}.toast-region{right:12px;top:74px}.choice-fieldset label{display:flex;margin:8px 0}.drawer-panel{width:100%}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}}
