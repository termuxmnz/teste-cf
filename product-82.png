:root{--bg:#09090b;--surface:#111114;--surface2:#17171b;--line:rgba(255,255,255,.1);--text:#f4f4f5;--muted:#a1a1aa;--orange:#ff6b00;--green:#22c55e;--red:#ef4444;--yellow:#f59e0b;--radius:20px;--shadow:0 24px 80px rgba(0,0,0,.38)}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.5}button,input,select{font:inherit}button{cursor:pointer}.hidden{display:none!important}.eyebrow{margin:0 0 8px;font-size:.68rem;letter-spacing:.18em;font-weight:900;color:#ff914d}.toast-region{position:fixed;right:18px;top:18px;z-index:999;display:grid;gap:9px}.toast{padding:13px 15px;border-radius:12px;background:#19191e;border:1px solid var(--line);border-left:4px solid var(--orange);box-shadow:var(--shadow);max-width:380px}.toast.error{border-left-color:var(--red)}.toast.success{border-left-color:var(--green)}
.login-view{min-height:100vh;display:grid;place-items:center;padding:20px;background:radial-gradient(circle at 50% 20%,rgba(255,107,0,.13),transparent 36%)}.login-card{width:min(460px,100%);padding:30px;border:1px solid var(--line);background:linear-gradient(145deg,#151519,#0d0d10);border-radius:28px;box-shadow:var(--shadow)}.login-card img{width:84px;height:84px;object-fit:cover;border-radius:20px;margin-bottom:24px}.login-card h1{font-size:2.5rem;line-height:1;letter-spacing:-.05em;margin:0}.login-card p{color:var(--muted)}.login-card form{display:grid;gap:14px;margin:24px 0}.login-card label{display:grid;gap:7px}.login-card label span{font-size:.78rem;font-weight:700}.login-card input,.toolbar input,.toolbar select,.order-card select,.product-edit input,.store-admin select{width:100%;border:1px solid var(--line);background:#111115;color:var(--text);border-radius:12px;padding:12px 13px;outline:none}.login-card input:focus,.toolbar input:focus,.toolbar select:focus,.product-edit input:focus{border-color:var(--orange);box-shadow:0 0 0 3px rgba(255,107,0,.12)}.login-card form button{border:0;border-radius:13px;padding:13px;background:linear-gradient(135deg,var(--orange),#ff914d);color:#111;font-weight:900}.login-card small{display:block;color:#7f7f89;margin-bottom:18px}.login-card a{color:#fdba74}
.dashboard{min-height:100vh;display:grid;grid-template-columns:250px 1fr}.sidebar{position:sticky;top:0;height:100vh;border-right:1px solid var(--line);padding:18px 14px;display:flex;flex-direction:column;background:#0c0c0f}.admin-brand{display:flex;align-items:center;gap:11px;padding:6px 7px 22px;color:inherit;text-decoration:none}.admin-brand img{width:48px;height:48px;object-fit:cover;border-radius:13px}.admin-brand span{display:flex;flex-direction:column}.admin-brand small{color:var(--muted)}.sidebar nav{display:grid;gap:5px}.sidebar nav button,.sidebar-bottom button,.sidebar-bottom a{border:0;background:transparent;color:var(--muted);padding:12px 13px;text-align:left;border-radius:11px;text-decoration:none}.sidebar nav button{display:flex;justify-content:space-between}.sidebar nav button.active,.sidebar nav button:hover{background:#1b1b20;color:#fff}.sidebar nav span{background:#2b2b32;border-radius:999px;padding:1px 7px;font-size:.72rem}.sidebar-bottom{margin-top:auto;display:grid;border-top:1px solid var(--line);padding-top:12px}.sidebar-bottom a:hover,.sidebar-bottom button:hover{color:#fff}
.admin-main{min-width:0;padding:28px clamp(18px,4vw,48px) 60px}.admin-header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:28px}.admin-header h1{font-size:clamp(2rem,4vw,3.8rem);letter-spacing:-.055em;line-height:1;margin:0}.header-controls{display:flex;align-items:center;gap:10px}.header-controls button,.panel-head button,.toolbar button{border:1px solid var(--line);background:#17171b;color:#fff;border-radius:11px;padding:10px 12px}.live-dot{font-size:.75rem;color:#86efac}.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.stats-grid article{border:1px solid var(--line);background:linear-gradient(145deg,#151519,#101013);border-radius:var(--radius);padding:22px;min-height:160px;display:flex;flex-direction:column}.stats-grid small,.stats-grid span{color:var(--muted)}.stats-grid strong{font-size:2.25rem;letter-spacing:-.05em;margin:auto 0 4px}.overview-grid{display:grid;grid-template-columns:1.4fr .8fr;gap:14px;margin-top:14px}.panel{border:1px solid var(--line);background:#111114;border-radius:var(--radius);padding:20px}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}.panel-head h2{margin:0;font-size:1.45rem}.recent-list,.stock-list{display:grid;gap:9px}.recent-item,.stock-item{border:1px solid var(--line);background:#16161a;border-radius:13px;padding:12px;display:flex;justify-content:space-between;gap:12px}.recent-item small,.stock-item small{display:block;color:var(--muted)}.status-pill{display:inline-flex;align-items:center;padding:5px 8px;border-radius:999px;font-size:.68rem;font-weight:800;background:rgba(245,158,11,.1);color:#fcd34d}.status-pill.confirmado,.status-pill.recebido{background:rgba(59,130,246,.1);color:#93c5fd}.status-pill.em_preparo{background:rgba(168,85,247,.12);color:#d8b4fe}.status-pill.pronto,.status-pill.entregue{background:rgba(34,197,94,.1);color:#86efac}.status-pill.cancelado{background:rgba(239,68,68,.1);color:#fca5a5}
.toolbar{display:grid;grid-template-columns:200px 200px 1fr auto;gap:10px;margin-bottom:16px}.toolbar .danger{border-color:rgba(239,68,68,.35);color:#fca5a5}.orders-list,.products-list{display:grid;gap:11px}.order-card{border:1px solid var(--line);background:#111114;border-radius:17px;padding:17px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px}.order-card h3{margin:0}.order-meta{display:flex;flex-wrap:wrap;gap:8px 15px;color:var(--muted);font-size:.82rem;margin:7px 0}.order-items-preview{color:#d4d4d8;font-size:.83rem}.order-actions{display:flex;align-items:center;gap:8px;min-width:245px}.order-actions select{min-width:170px}.order-actions button{border:1px solid var(--line);background:#1c1c21;color:#fff;border-radius:10px;padding:10px}.product-card-admin{border:1px solid var(--line);background:#111114;border-radius:17px;padding:14px;display:grid;grid-template-columns:82px minmax(0,1fr);gap:15px}.product-card-admin img{width:82px;height:82px;object-fit:cover;border-radius:12px}.product-admin-head{display:flex;justify-content:space-between;gap:10px}.product-admin-head h3{margin:0}.product-admin-head small{color:var(--muted)}.product-edit{display:grid;grid-template-columns:2fr 130px 100px auto auto;gap:9px;align-items:end;margin-top:12px}.product-edit label{display:grid;gap:5px;font-size:.72rem;color:var(--muted)}.product-edit button{height:42px;border:0;border-radius:10px;background:var(--orange);font-weight:900;color:#111;padding:0 15px}.toggle{display:flex!important;align-items:center;gap:7px!important;height:42px}.toggle input{width:auto}.store-admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.store-admin-card{border:1px solid var(--line);background:#111114;border-radius:22px;padding:22px}.store-admin-card h2{font-size:1.8rem;margin:0}.store-admin-card p{color:var(--muted)}.store-admin-card .current{padding:10px 12px;border-radius:12px;background:#17171b;border:1px solid var(--line);margin:18px 0}.store-admin-card button{width:100%;margin-top:10px;border:0;background:var(--orange);padding:12px;border-radius:11px;font-weight:900}.info-panel{margin-top:14px}.mode-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mode-grid article{padding:15px;background:#17171b;border-radius:13px}.mode-grid p{color:var(--muted);font-size:.84rem;margin:6px 0 0}
dialog{border:0;background:transparent;color:var(--text);width:min(760px,calc(100% - 24px));padding:0}dialog::backdrop{background:rgba(0,0,0,.75);backdrop-filter:blur(7px)}.dialog-card{position:relative;background:#101014;border:1px solid var(--line);border-radius:24px;padding:25px;max-height:90vh;overflow:auto;box-shadow:var(--shadow)}.dialog-close{position:absolute;right:14px;top:14px;width:40px;height:40px;border:1px solid var(--line);background:#1c1c21;color:#fff;border-radius:10px;font-size:1.4rem}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.detail-box{border:1px solid var(--line);background:#17171b;border-radius:12px;padding:12px}.detail-box small{color:var(--muted)}.detail-items{display:grid;gap:10px;margin-top:18px}.detail-item{border:1px solid var(--line);border-radius:13px;padding:13px}.detail-item p{color:var(--muted);font-size:.82rem}.detail-total{margin-top:18px;border-top:1px solid var(--line);padding-top:15px;display:grid;gap:5px}.detail-total div{display:flex;justify-content:space-between}.detail-total .grand{font-size:1.2rem;font-weight:900}
@media(max-width:1000px){.dashboard{grid-template-columns:1fr}.sidebar{position:static;height:auto;border-right:0;border-bottom:1px solid var(--line)}.sidebar nav{grid-template-columns:repeat(4,1fr);overflow:auto}.sidebar-bottom{display:none}.stats-grid{grid-template-columns:1fr 1fr}.overview-grid{grid-template-columns:1fr}.store-admin-grid{grid-template-columns:1fr}.product-edit{grid-template-columns:1fr 1fr}.admin-brand{padding-bottom:12px}}
@media(max-width:650px){.admin-main{padding:18px 12px 50px}.admin-header{align-items:flex-start}.live-dot{display:none}.stats-grid{grid-template-columns:1fr 1fr}.stats-grid article{min-height:130px;padding:15px}.stats-grid strong{font-size:1.7rem}.toolbar{grid-template-columns:1fr}.order-card{grid-template-columns:1fr}.order-actions{min-width:0;display:grid;grid-template-columns:1fr auto}.product-card-admin{grid-template-columns:62px 1fr}.product-card-admin img{width:62px;height:62px}.product-edit{grid-column:1/-1;grid-template-columns:1fr 1fr}.product-edit label:first-child{grid-column:1/-1}.sidebar nav{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:max-content}.sidebar nav button{white-space:nowrap}.mode-grid{grid-template-columns:1fr}.detail-grid{grid-template-columns:1fr}}
