<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="robots" content="noindex,nofollow"><meta name="theme-color" content="#09090b">
  <title>Painel — Code Forge Pedidos</title><link rel="icon" href="favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="admin.css"><script src="admin.js" defer></script>
</head>
<body>
  <div class="toast-region" id="toastRegion" aria-live="polite"></div>
  <section class="login-view" id="loginView">
    <div class="login-card">
      <img src="assets/brand/logo-code-forge.jpeg" alt="Code Forge">
      <p class="eyebrow">ÁREA RESTRITA</p><h1>Painel do proprietário</h1><p>Gerencie pedidos, estoque, preços e disponibilidade das duas operações.</p>
      <form id="adminLoginForm"><label><span>E-mail</span><input name="email" type="email" value="admin@codeforge.test" required></label><label><span>Senha</span><input name="password" type="password" value="CodeForge@2026" required></label><button>Entrar no painel</button></form>
      <small>Credenciais visíveis somente nesta demonstração. Em produção, ficam em variáveis protegidas do servidor.</small>
      <a href="index.html">← Voltar ao cardápio</a>
    </div>
  </section>

  <div class="dashboard hidden" id="dashboard">
    <aside class="sidebar">
      <a class="admin-brand" href="index.html"><img src="assets/brand/logo-code-forge.jpeg" alt="Code Forge"><span><b>Code Forge</b><small>Painel de pedidos</small></span></a>
      <nav><button class="active" data-view="overview">Visão geral</button><button data-view="orders">Pedidos <span id="orderNavCount">0</span></button><button data-view="products">Produtos e estoque</button><button data-view="stores">Horários e operação</button></nav>
      <div class="sidebar-bottom"><a href="index.html" target="_blank">Abrir cardápio ↗</a><a href="acompanhar.html" target="_blank">Acompanhar pedido ↗</a><button id="logoutAdmin">Sair</button></div>
    </aside>

    <main class="admin-main">
      <header class="admin-header"><div><p class="eyebrow">SISTEMA DE PEDIDOS</p><h1 id="viewTitle">Visão geral</h1></div><div class="header-controls"><span class="live-dot">● Atualização automática</span><button id="refreshButton">Atualizar</button></div></header>

      <section class="view" id="overviewView">
        <div class="stats-grid"><article><small>Pedidos</small><strong id="statOrders">0</strong><span>Total registrado</span></article><article><small>Faturamento</small><strong id="statRevenue">R$ 0,00</strong><span>Pedidos não cancelados</span></article><article><small>Estoque crítico</small><strong id="statLowStock">0</strong><span>Produtos com 1 ou 0</span></article><article><small>Produtos ativos</small><strong id="statActive">0</strong><span>No cardápio</span></article></div>
        <div class="overview-grid"><section class="panel"><div class="panel-head"><div><p class="eyebrow">FILA ATUAL</p><h2>Pedidos recentes</h2></div><button data-go="orders">Ver todos</button></div><div id="recentOrders" class="recent-list"></div></section><section class="panel"><div class="panel-head"><div><p class="eyebrow">ESTOQUE</p><h2>Atenção necessária</h2></div><button data-go="products">Gerenciar</button></div><div id="stockWarnings" class="stock-list"></div></section></div>
      </section>

      <section class="view hidden" id="ordersView">
        <div class="toolbar"><select id="orderStoreFilter"><option value="all">Todas as operações</option><option value="restaurant">Restaurante</option><option value="snacks">Lanches</option></select><select id="orderStatusFilter"><option value="all">Todos os status</option></select><input id="orderSearch" type="search" placeholder="Buscar código, cliente ou telefone"><button id="clearOrderFilters">Limpar</button></div>
        <div id="ordersList" class="orders-list"></div>
      </section>

      <section class="view hidden" id="productsView">
        <div class="toolbar"><select id="productStoreFilter"><option value="all">Todas as operações</option><option value="restaurant">Restaurante</option><option value="snacks">Lanches</option></select><input id="productSearch" type="search" placeholder="Buscar produto"><button id="resetDemo" class="danger">Restaurar demonstração</button></div>
        <div id="productsList" class="products-list"></div>
      </section>

      <section class="view hidden" id="storesView">
        <div class="store-admin-grid" id="storesAdmin"></div>
        <section class="panel info-panel"><p class="eyebrow">COMO FUNCIONA</p><h2>Três modos de operação</h2><div class="mode-grid"><article><b>Aberto</b><p>Ignora o horário e mantém o cardápio disponível. Ideal para a demonstração.</p></article><article><b>Fechado</b><p>Bloqueia novas finalizações, mantendo o cardápio visível para consulta.</p></article><article><b>Automático</b><p>O servidor consulta o dia e o horário configurados antes de aceitar o pedido.</p></article></div></section>
      </section>
    </main>
  </div>

  <dialog id="orderDialog"><div class="dialog-card"><button class="dialog-close" id="closeOrderDialog">×</button><div id="orderDetails"></div></div></dialog>
</body>
</html>
