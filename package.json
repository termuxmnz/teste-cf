'use strict';
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const money=c=>new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format((c||0)/100);
const statusLabels={aguardando_whatsapp:'Aguardando WhatsApp',recebido:'Recebido',confirmado:'Confirmado',em_preparo:'Em preparo',pronto:'Pronto',saiu_para_entrega:'Saiu para entrega',entregue:'Entregue',cancelado:'Cancelado'};
let csrf='',data=null,currentView='overview';
function toast(msg,type='info'){const e=document.createElement('div');e.className=`toast ${type}`;e.textContent=msg;$('#toastRegion').append(e);setTimeout(()=>e.remove(),4200)}
async function api(url,options={}){const r=await fetch(url,{headers:{'Content-Type':'application/json',...(options.headers||{})},...options});const d=await r.json().catch(()=>({error:'Resposta inválida.'}));if(!r.ok)throw new Error(d.error||'Falha na operação.');return d}
function escapeHtml(v){return String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
function setView(view){currentView=view;$$('.view').forEach(v=>v.classList.add('hidden'));$(`#${view}View`).classList.remove('hidden');$$('[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===view));$('#viewTitle').textContent=({overview:'Visão geral',orders:'Pedidos',products:'Produtos e estoque',stores:'Horários e operação'})[view]}
async function loadDashboard(showToast=false){data=await api('/api/admin/dashboard');renderAll();if(showToast)toast('Painel atualizado.','success')}
function renderAll(){renderOverview();renderOrders();renderProducts();renderStores();$('#orderNavCount').textContent=data.orders.filter(o=>!['entregue','cancelado'].includes(o.status)).length}
function renderOverview(){const s=data.stats;$('#statOrders').textContent=s.orders;$('#statRevenue').textContent=money(s.revenue);$('#statLowStock').textContent=s.lowStock;$('#statActive').textContent=s.activeProducts;const recent=$('#recentOrders');recent.innerHTML='';data.orders.slice(0,6).forEach(o=>{const e=document.createElement('button');e.className='recent-item';e.innerHTML=`<span><b>${escapeHtml(o.code)}</b><small>${escapeHtml(o.customer.name)} • ${o.store==='restaurant'?'Restaurante':'Lanches'}</small></span><span><b>${money(o.total)}</b><small class="status-pill ${o.status}">${statusLabels[o.status]}</small></span>`;e.addEventListener('click',()=>openOrder(o.id));recent.append(e)});if(!data.orders.length)recent.innerHTML='<p>Nenhum pedido ainda.</p>';const stock=$('#stockWarnings');stock.innerHTML='';const low=data.products.filter(p=>p.stock<=1).sort((a,b)=>a.stock-b.stock);low.slice(0,8).forEach(p=>{const e=document.createElement('div');e.className='stock-item';e.innerHTML=`<span><b>${escapeHtml(p.name)}</b><small>${p.store==='restaurant'?'Restaurante':'Lanches'}</small></span><strong>${p.stock} un.</strong>`;stock.append(e)});if(!low.length)stock.innerHTML='<p>Todos os produtos estão com estoque acima de 1 unidade.</p>'}
function filteredOrders(){const store=$('#orderStoreFilter').value,status=$('#orderStatusFilter').value,q=$('#orderSearch').value.trim().toLowerCase();return data.orders.filter(o=>(store==='all'||o.store===store)&&(status==='all'||o.status===status)&&(!q||`${o.code} ${o.customer.name} ${o.customer.phone}`.toLowerCase().includes(q)))}
function renderOrders(){const statusSel=$('#orderStatusFilter');if(statusSel.options.length===1)data.statuses.forEach(s=>statusSel.insertAdjacentHTML('beforeend',`<option value="${s}">${statusLabels[s]}</option>`));const wrap=$('#ordersList');wrap.innerHTML='';const list=filteredOrders();if(!list.length){wrap.innerHTML='<p>Nenhum pedido encontrado.</p>';return}list.forEach(o=>{const e=document.createElement('article');e.className='order-card';const preview=o.items.map(i=>`${i.quantity}x ${i.name}`).join(' • ');e.innerHTML=`<div><div class="order-meta"><span>${escapeHtml(o.code)}</span><span>${new Date(o.createdAt).toLocaleString('pt-BR')}</span><span>${o.store==='restaurant'?'Restaurante':'Lanches'}</span></div><h3>${escapeHtml(o.customer.name)} — ${money(o.total)}</h3><div class="order-meta"><span>${escapeHtml(o.customer.phone)}</span><span>${o.fulfillment==='delivery'?'Entrega':'Retirada'}</span><span class="status-pill ${o.status}">${statusLabels[o.status]}</span></div><div class="order-items-preview">${escapeHtml(preview)}</div></div><div class="order-actions"><select aria-label="Alterar status">${data.statuses.map(s=>`<option value="${s}" ${s===o.status?'selected':''}>${statusLabels[s]}</option>`).join('')}</select><button type="button">Detalhes</button></div>`;const sel=$('select',e);sel.addEventListener('change',async()=>{if(sel.value==='cancelado'&&!confirm('Cancelar este pedido e devolver o estoque?')){sel.value=o.status;return}try{await api(`/api/admin/orders/${o.id}/status`,{method:'PATCH',headers:{'x-csrf-token':csrf},body:JSON.stringify({status:sel.value})});toast('Status atualizado.','success');await loadDashboard()}catch(err){toast(err.message,'error');sel.value=o.status}});$('button',e).addEventListener('click',()=>openOrder(o.id));wrap.append(e)})}
function renderProducts(){const store=$('#productStoreFilter').value,q=$('#productSearch').value.trim().toLowerCase();const list=data.products.filter(p=>(store==='all'||p.store===store)&&(!q||`${p.name} ${p.category}`.toLowerCase().includes(q)));const wrap=$('#productsList');wrap.innerHTML='';list.forEach(p=>{const e=document.createElement('article');e.className='product-card-admin';e.innerHTML=`<img src="${p.image}" alt=""><div><div class="product-admin-head"><div><h3>${escapeHtml(p.name)}</h3><small>${p.store==='restaurant'?'Restaurante':'Lanches'} • ${escapeHtml(p.category)}</small></div><span class="status-pill ${p.stock<=0?'cancelado':p.stock<=1?'aguardando_whatsapp':'pronto'}">${p.stock} em estoque</span></div><form class="product-edit"><label>Nome<input name="name" value="${escapeHtml(p.name)}" maxlength="120"></label><label>Preço (R$)<input name="price" type="number" step="0.01" min="0" value="${(p.price/100).toFixed(2)}"></label><label>Estoque<input name="stock" type="number" min="0" max="999" value="${p.stock}"></label><label class="toggle"><input name="active" type="checkbox" ${p.active?'checked':''}> Ativo</label><button>Salvar</button></form></div>`;const form=$('form',e);form.addEventListener('submit',async ev=>{ev.preventDefault();const fd=new FormData(form);try{await api(`/api/admin/products/${p.id}`,{method:'PATCH',headers:{'x-csrf-token':csrf},body:JSON.stringify({name:fd.get('name'),price:fd.get('price'),stock:fd.get('stock'),active:fd.get('active')==='on'})});toast('Produto atualizado.','success');await loadDashboard()}catch(err){toast(err.message,'error')}});wrap.append(e)})}
function renderStores(){const wrap=$('#storesAdmin');wrap.innerHTML='';Object.entries(data.stores).forEach(([id,s])=>{const e=document.createElement('article');e.className='store-admin-card';e.innerHTML=`<p class="eyebrow">${id==='restaurant'?'ALMOÇO':'NOITE'}</p><h2>${escapeHtml(s.label)}</h2><p>${escapeHtml(s.subtitle)}</p><div class="current">Modo atual: <b>${({open:'Aberto manualmente',closed:'Fechado manualmente',auto:'Horário automático'})[s.statusMode]}</b></div><label>Modo de funcionamento<select><option value="open" ${s.statusMode==='open'?'selected':''}>Aberto</option><option value="closed" ${s.statusMode==='closed'?'selected':''}>Fechado</option><option value="auto" ${s.statusMode==='auto'?'selected':''}>Automático</option></select></label><button>Aplicar modo</button>`;const sel=$('select',e);$('button',e).addEventListener('click',async()=>{try{await api(`/api/admin/stores/${id}`,{method:'PATCH',headers:{'x-csrf-token':csrf},body:JSON.stringify({statusMode:sel.value})});toast('Operação atualizada.','success');await loadDashboard()}catch(err){toast(err.message,'error')}});wrap.append(e)})}
function openOrder(id){const o=data.orders.find(x=>x.id===id);if(!o)return;const items=o.items.map(i=>`<article class="detail-item"><b>${i.quantity}x ${escapeHtml(i.name)} — ${money(i.total)}</b>${i.options.length?`<p>${i.options.map(x=>`• ${escapeHtml(x.label)}`).join('<br>')}</p>`:''}${i.note?`<p><b>Observação:</b> ${escapeHtml(i.note)}</p>`:''}</article>`).join('');$('#orderDetails').innerHTML=`<p class="eyebrow">PEDIDO ${escapeHtml(o.code)}</p><h2>${escapeHtml(o.customer.name)}</h2><div class="detail-grid"><div class="detail-box"><small>Telefone</small><b>${escapeHtml(o.customer.phone)}</b></div><div class="detail-box"><small>Operação</small><b>${o.store==='restaurant'?'Restaurante':'Lanches'}</b></div><div class="detail-box"><small>Modalidade</small><b>${o.fulfillment==='delivery'?'Entrega':'Retirada'}</b></div><div class="detail-box"><small>Status</small><b>${statusLabels[o.status]}</b></div>${o.customer.address?`<div class="detail-box"><small>Endereço</small><b>${escapeHtml(o.customer.address)}</b></div>`:''}<div class="detail-box"><small>Pagamento</small><b>${escapeHtml(o.paymentMethod)}</b></div></div><div class="detail-items">${items}</div><div class="detail-total"><div><span>Subtotal</span><b>${money(o.subtotal)}</b></div><div><span>Taxa</span><b>${money(o.deliveryFee)}</b></div><div class="grand"><span>Total oficial</span><b>${money(o.total)}</b></div></div>`;$('#orderDialog').showModal()}
function bind(){
  $('#adminLoginForm').addEventListener('submit',async e=>{e.preventDefault();const fd=new FormData(e.currentTarget);try{const d=await api('/api/admin/login',{method:'POST',body:JSON.stringify(Object.fromEntries(fd))});csrf=d.csrf;$('#loginView').classList.add('hidden');$('#dashboard').classList.remove('hidden');await loadDashboard();toast('Bem-vindo ao painel.','success')}catch(err){toast(err.message,'error')}});
  $$('[data-view]').forEach(b=>b.addEventListener('click',()=>setView(b.dataset.view)));$$('[data-go]').forEach(b=>b.addEventListener('click',()=>setView(b.dataset.go)));$('#refreshButton').addEventListener('click',()=>loadDashboard(true));$('#logoutAdmin').addEventListener('click',async()=>{await api('/api/admin/logout',{method:'POST',body:'{}'});location.reload()});
  ['orderStoreFilter','orderStatusFilter','orderSearch'].forEach(id=>$('#'+id).addEventListener('input',renderOrders));$('#clearOrderFilters').addEventListener('click',()=>{$('#orderStoreFilter').value='all';$('#orderStatusFilter').value='all';$('#orderSearch').value='';renderOrders()});['productStoreFilter','productSearch'].forEach(id=>$('#'+id).addEventListener('input',renderProducts));
  $('#resetDemo').addEventListener('click',async()=>{if(!confirm('Restaurar estoque para 4, apagar pedidos e contas da demonstração?'))return;try{await api('/api/admin/reset',{method:'POST',headers:{'x-csrf-token':csrf},body:'{}'});toast('Demonstração restaurada.','success');await loadDashboard()}catch(err){toast(err.message,'error')}});$('#closeOrderDialog').addEventListener('click',()=>$('#orderDialog').close())
}
(async function init(){bind();try{const s=await api('/api/admin/session');if(s.authenticated){csrf=s.csrf;$('#loginView').classList.add('hidden');$('#dashboard').classList.remove('hidden');await loadDashboard();setInterval(()=>loadDashboard().catch(()=>{}),8000)}}catch{}})();
